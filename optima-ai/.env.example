# Optima AI Configuration
# Copy to .env and fill in your values

# Application
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY_MINUTES=60

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=optima
DB_USER=optima
DB_PASSWORD=optima

# Langfuse (Prompt Management & Observability)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# GitHub MCP Provider (optional)
GITHUB_TOKEN=ghp_xxxxx
GITHUB_DEFAULT_REPO=owner/repo

# Atlassian MCP Provider (optional)
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=xxxxx
ATLASSIAN_PROJECT_KEY=PROJ

# Datahub MCP Provider (optional)
DATAHUB_BASE_URL=http://localhost:8080
DATAHUB_TOKEN=xxxxx
