# Copy to .env and fill in. All values are optional; the agent runs
# in mock mode if nothing is provided.

# OpenAI — enables real LLM reasoning. Leave blank for mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Tavily or SerpAPI for real web search. Leave blank for mock search.
TAVILY_API_KEY=

# Observability
PRA_LOG_LEVEL=INFO
PRA_LOG_FILE=personal_research_assistant/data/agent.log

# Memory storage location
PRA_DATA_DIR=personal_research_assistant/data
